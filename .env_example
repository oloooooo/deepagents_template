# 复制成 .env 后填真值。.env 已在 .gitignore 里，这个示例文件是提交的。
# 语法：KEY=值，等号两边不空格，值一般不用加引号；注释单独一行以 # 开头。
# 编码必须存成 UTF-8（不带 BOM 也行），存成 GBK/UTF-16 会在 import 时直接抛 UnicodeDecodeError。
# 改完要重启进程：配置在 import 时读一次。

# ---------- 数据库 / 密钥 ----------
# 覆盖 config/config.yaml 里的默认值。优先级：系统环境变量 > 本文件 > config.yaml。
# 变量名要和 config.yaml 里的 ${oc.env:变量名,...} 对得上，改名要两边一起改。
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=1234
PG_DB=user_related

# 生产必须换成 >=32 字节的随机串：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=dev-only-secret-key-change-me-before-prod

# LOG_LEVEL=INFO
# LOG_DIR=logs

# ---------- LLM 模型 ----------
# 由 agents/config.py 的 ModelConfig 读取（字段名走 validation_alias）。
# 阿里云百炼要选「兼容 OpenAI」的 Base URL。
OPEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPEN_MODEL=qwen3-max
OPEN_API_KEY=sk-f11111111111111111111111111111111
